{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "language": { "type": "string" },
    "chat": {
      "type": "object",
      "properties": {
        "auto_reply": { "type": "boolean" }
      },
      "required": ["auto_reply"]
    },
    "reviews": { "type": "object" },
    "early_access": { "type": "boolean" },
    "auto_labels": { "type": "object" },
    "auto_assign": { "type": "object" },
    "auto_review": { "type": "object" }
  },
  "required": ["language", "chat", "reviews", "early_access", "auto_labels", "auto_assign", "auto_review"]
}
