#!/bin/sh
# Husky pre-commit hook for LightSpeed WP Scripts

echo "🔍 Running pre-commit checks..."


# Robust project root check using git
PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$PROJECT_ROOT" ] || [ ! -f "$PROJECT_ROOT/package.json" ]; then
    echo "❌ Not in project root directory (could not find package.json at repo root)"
    exit 1
fi
cd "$PROJECT_ROOT"

# Node.js version check using .nvmrc (optional)
if [ -f .nvmrc ]; then
    REQUIRED_NODE_VERSION=$(cat .nvmrc | head -n1 | tr -d 'v')
    CURRENT_NODE_VERSION=$(node -v 2>/dev/null | tr -d 'v')
    if [ -z "$CURRENT_NODE_VERSION" ]; then
        echo "⚠️  Node.js is not installed or not in PATH."
        exit 1
    fi
    if [ "$REQUIRED_NODE_VERSION" != "$CURRENT_NODE_VERSION" ]; then
        echo "⚠️  Node.js version mismatch: required $REQUIRED_NODE_VERSION, current $CURRENT_NODE_VERSION"
        echo "Please run 'nvm use' or switch to the correct Node.js version."
        exit 1
    fi
fi

# Install dependencies if node_modules doesn't exist
if [ ! -d "node_modules" ]; then
    echo "📦 Installing dependencies..."
    npm install
fi

# Run linting
echo "🧹 Running linters..."
npm run lint || {
    echo "❌ Linting failed. Please fix the issues before committing."
    exit 1
}
npx lint-staged

# Run tests
echo "🧪 Running tests..."
if command -v bats >/dev/null 2>&1; then
    npm test || {
        echo "❌ Tests failed. Please fix the issues before committing."
        exit 1
    }
else
    echo "⚠️  Bats not available, skipping tests"
fi

# Check for TODO/FIXME comments in staged files
echo "🔍 Checking for TODO/FIXME comments..."
staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(sh|js|ts|md)$' || true)
if [ -n "$staged_files" ]; then
    todo_count=$(echo "$staged_files" | xargs grep -l "TODO\|FIXME" 2>/dev/null | wc -l || echo "0")
    if [ "$todo_count" -gt 0 ]; then
        echo "⚠️  Found $todo_count file(s) with TODO/FIXME comments:"
        echo "$staged_files" | xargs grep -l "TODO\|FIXME" 2>/dev/null || true
        echo "Consider resolving these before committing."
    fi
fi

echo "✅ Pre-commit checks passed!"
