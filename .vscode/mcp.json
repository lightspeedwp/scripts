{
    "name": "lightspeedwp-automation",
    "version": "1.0.0",
    "description": "MCP configuration for LightSpeed WP automation repository",
    "capabilities": {
        "resources": true,
        "tools": true,
        "prompts": true
    },
    "resources": [
        {
            "uri": "file:///scripts/",
            "name": "Automation Scripts",
            "description": "Shell scripts for automation tasks",
            "mimeType": "text/x-shellscript"
        },
        {
            "uri": "file:///workflows/",
            "name": "GitHub Workflows",
            "description": "Reusable GitHub Actions workflows",
            "mimeType": "application/x-yaml"
        },
        {
            "uri": "file:///tests/",
            "name": "Test Files",
            "description": "Bats test files and validation scripts",
            "mimeType": "text/x-shellscript"
        }
    ],
    "tools": [
        {
            "name": "generate_script",
            "description": "Generate a new shell script with proper template and naming conventions",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Script name in kebab-case"
                    },
                    "description": {
                        "type": "string",
                        "description": "Brief description of what the script does"
                    },
                    "category": {
                        "type": "string",
                        "enum": ["deployment", "maintenance", "utility"],
                        "description": "Script category"
                    }
                },
                "required": ["name", "description", "category"]
            }
        },
        {
            "name": "generate_workflow",
            "description": "Generate a new GitHub Actions workflow with reusability in mind",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Workflow name in kebab-case"
                    },
                    "trigger": {
                        "type": "string",
                        "enum": ["workflow_call", "push", "pull_request", "schedule"],
                        "description": "Primary workflow trigger"
                    },
                    "description": {
                        "type": "string",
                        "description": "Workflow description"
                    }
                },
                "required": ["name", "trigger", "description"],
                "additionalProperties": false
            }
        },
        {
            "name": "generate_test",
            "description": "Generate Bats test file for a given script",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "script_name": {
                        "type": "string",
                        "description": "Name of the script to test (without .sh extension)"
                    }
                },
                "required": ["script_name"],
                "additionalProperties": false
            }
        }
    ],
    "prompts": [
        {
            "name": "script_review",
            "description": "Review a shell script for best practices and conventions",
            "arguments": [
                {
                    "name": "script_path",
                    "description": "Path to the script file to review"
                }
            ]
        },
        {
            "name": "workflow_optimization",
            "description": "Suggest optimizations for a GitHub Actions workflow",
            "arguments": [
                {
                    "name": "workflow_path",
                    "description": "Path to the workflow YAML file"
                }
            ]
        }
    ],
    "context": {
        "naming_convention": "kebab-case",
        "shell_standard": "bash with set -euo pipefail",
        "test_framework": "bats-core",
        "documentation_style": "markdown"
    }
}
