# ============================================================================
# .npmrc
# Purpose: npm configuration for consistent installs and project policy
# Reference: https://docs.npmjs.com/cli/v10/configuring-npm/npmrc
# ============================================================================
save-exact=true         # Always save exact versions in package.json
package-lock=true       # Always generate package-lock.json
fund=false              # Disable funding messages
engine-strict=true      # Enforce engines field in package.json
# resolution-mode=highest  # Remove or comment out for deterministic installs
save-exact=true
package-lock=true
fund=false
engine-strict=true
# resolution-mode=highest  # Remove or comment out for deterministic installs